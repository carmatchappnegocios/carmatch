model LocationLog {
  id             String       @id @default(cuid())
  userId         String
  appointmentId  String?
  sosAlertId     String?
  latitude       Float
  longitude      Float
  batteryLevel   Float?
  recordedAt     DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sosAlert       SOSAlert?    @relation(fields: [sosAlertId], references: [id], onDelete: Cascade)
  
  @@index([userId, recordedAt])
  @@index([sosAlertId])
  @@index([appointmentId])
}

model BetaSession {
  id             String   @id @default(cuid())
  userId         String
  date           String   // "2026-04-21"
  sessionStart   DateTime @default(now())
  lastPing       DateTime @default(now())
  maxDuration    Int      @default(0)    // segundos, sesión continua actual
  completedToday Boolean  @default(false) // true cuando llega a 240s continuos
  deviceOS       String   @default("Unknown")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model BlockedIdentity {
  id            String   @id @default(cuid())
  blockedUserId String
  blockedByEmail String?
  blockedByIp   String?
  reason        String
  blockedAt     DateTime @default(now())
  blockedBy     String   // admin userId who performed the block

  @@index([blockedUserId])
  @@index([blockedByEmail])
  @@index([blockedByIp])
}
