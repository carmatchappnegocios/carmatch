{
    "name": "CarMatch Social",
    "short_name": "CarMatch",
    "description": "Red social para comprar, vender y descubrir vehículos y negocios automotrices en tiempo real",
    "start_url": "/",
    "id": "/?source=pwa",
    "display": "standalone",
    "background_color": "#0f172a",
    "theme_color": "#0f172a",
    "orientation": "portrait",
    "scope": "/",
    "lang": "es-MX",
    "prefer_related_applications": false,
    "dir": "ltr",
    "image_url": "https://www.carmatchapp.net/portada_1024x500.png?v=23",
    "display_override": [
        "standalone",
        "minimal-ui",
        "window-controls-overlay"
    ],
    "related_applications": [
        {
            "platform": "play",
            "url": "https://play.google.com/store/apps/details?id=net.carmatchapp.twa",
            "id": "net.carmatchapp.twa"
        }
    ],
    "icons": [
