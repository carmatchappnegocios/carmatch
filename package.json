{
  "name": "carmatch",
  "version": "0.1.3",
  "private": true,
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "scripts": {
    "dev": "next dev",
    "dev:socket": "tsx server.ts",
    "build": "rimraf .next --glob || echo Skip rimraf && prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "clean": "rimraf .next --glob || echo Skip rimraf",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "migrate-dev": "npx prisma migrate dev",
    "db:scout-world": "tsx scripts/import_gas_stations_world.ts",
    "db:prepare-cities": "tsx scripts/prepare_cities.ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.1.0",
    "@sentry/nextjs": "^9.0.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@tanstack/react-query": "^5.90.20",

    "bcryptjs": "^2.4.3",
    "browser-image-compression": "^2.0.2",
    "cloudinary": "^2.9.0",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.556.0",
    "mapbox-gl": "^3.16.0",
    "next": "15.5.12",
    "next-auth": "5.0.0-beta.25",
    "qrcode.react": "^3.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.18.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "stripe": "^17.5.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/ui": "^3.2.1",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "happy-dom": "^18.0.1",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  },
  "overrides": {
    "next-auth": "5.0.0-beta.25"
  }
}
