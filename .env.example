# 🔐 CarMatch Environment Secrets
# Configura estas variables en tu panel de Vercel (Settings -> Environment Variables)

# 🌐 Base URL (Production Domain)
NEXTAUTH_URL="https://tu-proyecto.vercel.app"

# 🔑 Database (PostgreSQL / Neon / Supabase)
# 💰 OPTIMIZADO: Con connection pooling para ahorrar $100k/mes
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require&connection_limit=10&pool_timeout=20"

# ✉️ Resend (Email Verification)
# Obtén tu API key GRATIS en: https://resend.com/api-keys (100 emails/día gratis)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# 🛡️ NextAuth Security
# Generar uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET="tu_super_secreto_aqui_generado"

# 🤖 Google Integrations
# 1. Login Social (Google Cloud Console -> OAuth Credentials)
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"

# 2. AI & Maps (Google Cloud & AI Studio)
# Para Mapas y para el Agente Gemini Auto-Updater
GOOGLE_API_KEY="tu_clave_de_api_de_google_ai_y_maps"

# 3. Gemini AI (para búsqueda inteligente multiidioma en MapStore)
# Obtén tu API key GRATIS en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="tu_gemini_api_key_aqui"

# ☁️ Cloudinary (Imágenes)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# 💳 Stripe (Pagos)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 🔔 Web Push (Notificaciones)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="tu_vapid_public_key"
VAPID_PRIVATE_KEY="tu_vapid_private_key"

# 📱 Social Media Automation (Global Agent - Facebook/Instagram)
# Token de acceso a la Página (con permisos pages_manage_posts, instagram_content_publish)
FACEBOOK_PAGE_TOKEN="EAA..."
FACEBOOK_PAGE_ID="123456789"
INSTAGRAM_ACCOUNT_ID="987654321"

# ⏰ Cron Automation (Para Vercel Cron)
CRON_SECRET="secreto_super_seguro_para_proteger_el_cron"

# 🎨 OpenAI (Opcional - Fallback de Imagen si Gemini falla)
OPENAI_API_KEY="sk-..."
